# --- DigiMarkIn hub (JWT verification) ---
DIGIMARKIN_JWKS_URL=https://digimarkin.com/.well-known/jwks.json
DIGIMARKIN_JWT_ISSUER=https://digimarkin.com
DIGIMARKIN_JWT_AUDIENCE=nexus-orchestrator

# --- GitHub OAuth App (register at github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-orchestrator-domain.com/integrations/github/callback

# --- LLM Provider ---
# Options: anthropic, openai, groq, gemini, openrouter
LLM_PROVIDER=groq
LLM_API_KEY=your-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
#
# Examples for each provider:
#   Groq:        LLM_PROVIDER=groq       LLM_MODEL=llama-3.3-70b-versatile
#   Gemini:      LLM_PROVIDER=gemini     LLM_MODEL=gemini-2.0-flash
#   OpenAI:      LLM_PROVIDER=openai     LLM_MODEL=gpt-4o
#   Anthropic:   LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-4-6
#   OpenRouter:  LLM_PROVIDER=openrouter LLM_MODEL=anthropic/claude-3.5-sonnet

# --- Infrastructure ---
POSTGRES_PASSWORD=change-me-to-something-real
DATABASE_URL=postgresql://nexus:change-me-to-something-real@postgres:5432/nexus_orchestrator
REDIS_URL=redis://redis:6379/0

# --- Token encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
TOKEN_ENCRYPTION_KEY=

# --- Cost control (0 = unlimited) ---
MAX_LLM_CALLS_PER_TASK=0
