# Manic AI Orchestrator — Environment Configuration
# Copy this to .env and fill in your values

# ============================================================================
# LLM PROVIDER (Required)
# ============================================================================
# Options: anthropic, openai, groq, gemini, openrouter, local
LLM_PROVIDER=groq
LLM_API_KEY=your-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=  # only for local provider (e.g., http://localhost:11434/v1)

# Examples:
#   Groq:        LLM_PROVIDER=groq       LLM_API_KEY=gsk_...        LLM_MODEL=llama-3.3-70b-versatile
#   Gemini:      LLM_PROVIDER=gemini     LLM_API_KEY=AI...          LLM_MODEL=gemini-2.0-flash
#   OpenAI:      LLM_PROVIDER=openai     LLM_API_KEY=sk-...         LLM_MODEL=gpt-4o
#   Anthropic:   LLM_PROVIDER=anthropic  LLM_API_KEY=sk-ant-...     LLM_MODEL=claude-sonnet-4-20250514
#   OpenRouter:  LLM_PROVIDER=openrouter LLM_API_KEY=sk-or-...      LLM_MODEL=anthropic/claude-3.5-sonnet
#   Local:       LLM_PROVIDER=local      LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:3b

# ============================================================================
# DATABASE (Required for production)
# ============================================================================
# For NeonDB (recommended for Render deployment):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# For other PostgreSQL providers:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# For SQLite (local development only):
DATABASE_URL=sqlite:///./manic_ai.db
#
# Get your free NeonDB at: https://neon.tech
# NeonDB free tier: 0.5 GB storage, unlimited projects

# ============================================================================
# REDIS (Optional — only needed for Celery worker deployment)
# ============================================================================
# For Render free tier: Leave empty (uses in-process background tasks)
# For Celery deployment: Uncomment and set your Redis URL
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# AUTHENTICATION (Optional — if empty, auth is disabled for testing)
# ============================================================================
# Generate a strong random string for production:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ============================================================================
# GITHUB OAUTH (Optional — only needed for coding tasks)
# ============================================================================
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/integrations/github/callback

# ============================================================================
# SECURITY (Optional — auto-generated if empty)
# ============================================================================
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ============================================================================
# ADMIN ENDPOINTS (Optional)
# ============================================================================
# Protect /admin/* endpoints with this secret
ADMIN_SECRET=
# Comma-separated IPs allowed to access /admin (empty = all)
ADMIN_ALLOWED_IPS=

# ============================================================================
# COST CONTROL (Optional)
# ============================================================================
# Max LLM calls per task (0 = unlimited)
MAX_LLM_CALLS_PER_TASK=0

# ============================================================================
# RATE LIMITING (Optional)
# ============================================================================
RATE_LIMIT_TASKS_PER_MINUTE=10
RATE_LIMIT_TASKS_PER_HOUR=100

# ============================================================================
# TASK TIMEOUT (Optional)
# ============================================================================
# Auto-fail tasks stuck in "running" for this many minutes
TASK_TIMEOUT_MINUTES=30

# ============================================================================
# FILE SIZE LIMITS (Optional)
# ============================================================================
# Max file size for coding agents (bytes)
MAX_FILE_SIZE_BYTES=1000000
# Max files per commit
MAX_FILES_PER_COMMIT=50

# ============================================================================
# CORS (Optional)
# ============================================================================
# Comma-separated origins, or * for all
ALLOWED_ORIGINS=*
