# --- DigiMarkIn hub ---
DIGIMARKIN_JWKS_URL=https://digimarkin.com/.well-known/jwks.json
DIGIMARKIN_JWT_ISSUER=https://digimarkin.com
DIGIMARKIN_JWT_AUDIENCE=nexus-orchestrator

# --- GitHub OAuth App (register at github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://nexus-orchestrator.digimarkin.com/integrations/github/callback

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Infra (these match docker-compose.yml's service names — don't use localhost) ---
POSTGRES_PASSWORD=change-me-to-something-real
DATABASE_URL=postgresql://nexus:change-me-to-something-real@postgres:5432/nexus_orchestrator
REDIS_URL=redis://redis:6379/0

# --- Token encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
TOKEN_ENCRYPTION_KEY=

# --- Cost control (0 = unlimited) ---
MAX_LLM_CALLS_PER_TASK=0
